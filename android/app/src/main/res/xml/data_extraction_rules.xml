<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune sauvegarde ni transfert : les préférences contiennent l'adresse du
     serveur, et le WebView conserve les jetons de session. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
