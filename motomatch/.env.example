# Copier en .env et adapter. Ne jamais versionner le .env réel.

# development | production
MOTOMATCH_ENV=development

# Obligatoire en production, 32 caractères minimum. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ce secret dérive aussi le décalage de grille géographique : le changer
# déplace la position publiée de tous les utilisateurs.
MOTOMATCH_SECRET_KEY=dev-only-insecure-secret-do-not-use-in-production

MOTOMATCH_DB=motomatch/motomatch.db

# Durées de vie des jetons (secondes)
MOTOMATCH_ACCESS_TOKEN_TTL_SECONDS=900
MOTOMATCH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Confidentialité géographique
MOTOMATCH_GEO_GRID_METERS=1000
MOTOMATCH_DISTANCE_BUCKET_KM=5

# Croisements (opt-in côté utilisateur)
MOTOMATCH_CROSSING_CELL_METERS=500
MOTOMATCH_CROSSING_WINDOW_SECONDS=600
MOTOMATCH_CROSSING_BUCKET_MINUTES=15
MOTOMATCH_PING_RETENTION_HOURS=24

# Exposition HTTP — listes séparées par des virgules.
# En production : hôtes explicites, origines en https, documentation coupée.
MOTOMATCH_TRUSTED_HOSTS=*
MOTOMATCH_CORS_ORIGINS=http://localhost:8000
MOTOMATCH_DOCS_ENABLED=true
