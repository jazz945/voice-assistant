[Unit]
Description=Sauvegarde de la base MotoMatch
After=motomatch.service

[Service]
Type=oneshot
User=motomatch
Group=motomatch
Environment=MOTOMATCH_DB=/var/lib/motomatch/motomatch.db
Environment=BACKUP_DIR=/var/backups/motomatch
Environment=BACKUP_KEEP=14
ExecStart=/opt/motomatch/.venv/bin/python /opt/motomatch/deploy/backup.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/motomatch
