# Copier en .env et compléter. Ne jamais versionner .env.

# --- Obligatoire ---
# Active le garde-fou de démarrage : sans « production » ici, l'application
# accepte une clé de développement, des hôtes en « * » et la doc ouverte.
MOTOMATCH_ENV=production

# Clé de signature. En générer une avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# La changer invalide toutes les sessions et tous les décalages de grille
# géographique. À conserver comme un mot de passe.
MOTOMATCH_SECRET_KEY=

# Adresse servie par Caddy.
#   domaine public : motomatch.mondomaine.fr
#   réseau local   : motomatch.maison
MOTOMATCH_SITE_ADDRESS=

# Fichier Caddy à utiliser : Caddyfile (domaine public) ou Caddyfile.lan.
CADDYFILE=Caddyfile

# Noms d'hôte acceptés par l'application. Doit contenir MOTOMATCH_SITE_ADDRESS.
# Laisser « * » ouvre la porte au rebind DNS : à renseigner.
MOTOMATCH_TRUSTED_HOSTS=motomatch.mondomaine.fr

# --- Recommandé ---
# Documentation interactive de l'API : à couper en production, elle décrit
# toute la surface d'attaque.
MOTOMATCH_DOCS_ENABLED=false

# Origines autorisées pour le navigateur. Vide si le site et l'API partagent
# la même origine, ce qui est le cas ici.
MOTOMATCH_CORS_ORIGINS=

# --- Paiement Stripe (voir motomatch/PAIEMENT_STRIPE.md) ---
# Tant que ces quatre valeurs manquent, le bouton « S'abonner » ne redirige pas.
MOTOMATCH_STRIPE_SECRET_KEY=
MOTOMATCH_STRIPE_PRICE_MONTHLY=
MOTOMATCH_STRIPE_PRICE_BIANNUAL=
MOTOMATCH_PAYMENT_WEBHOOK_SECRET=
MOTOMATCH_STRIPE_SUCCESS_URL=
MOTOMATCH_STRIPE_CANCEL_URL=

# --- Sauvegardes ---
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400
